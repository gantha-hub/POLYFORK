# ==============================================================================
# VrikshaVision Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Meta
PROJECT_NAME="VrikshaVision: Tree Digital Twin"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (SQLite file-based database)
DATABASE_URL=sqlite:///./data/vrikshavision.db

# Security & Authentication
# Leave blank to allow open access during local development, or set a key to enforce X-API-Key header
API_KEY=

# ML Model Backend Selection: "mock" or "torch"
# - mock: Generates labeled synthetic tree detections without needing GPU or weights
# - torch: Loads real neural network weights from WEIGHTS_PATH
MODEL_BACKEND=mock
WEIGHTS_PATH=./weights/tree_detector_weights.pt

# File Upload and Processing Limits
MAX_UPLOAD_SIZE_MB=250
ALLOWED_EXTENSIONS=["tif", "tiff", "jpg", "jpeg", "png"]

# CORS Settings (frontend URLs)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
